<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xml — Submit this to Google Search Console
  Place at: public/sitemap.xml
  URL will be: https://yourdomain.com/sitemap.xml

  Replace "yourdomain.com" everywhere below with your real domain.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!-- ── Landing page ── -->
  <url>
    <loc>https://yourdomain.com/</loc>
    <lastmod>2026-05-22</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- ── Vertical landing pages ──
       Static marketing pages — one per profession vertical.
       Each links its "Start free" CTAs to /?vertical={slug}&signup=1
       so visitors land in signup mode with the right profession pre-selected. -->
  <url>
    <loc>https://yourdomain.com/trades/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://yourdomain.com/beauty/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://yourdomain.com/professional/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <!--
    ── Tradesperson booking pages ──
    These are the most important for local SEO.
    Each /b/[slug] page is a public profile + booking form
    that Google can index and rank for "[trade] [city]" searches.

    Add one <url> block per tradesperson who signs up.
    You can generate this dynamically from Supabase — see seo/generate-sitemap.js
  -->
  <url>
    <loc>https://yourdomain.com/b/jakemorrison</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>

</urlset>
